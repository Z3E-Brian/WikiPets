# Copy this file to .env and fill in your own values: cp .env.example .env
# .env is ignored by git. Never commit real credentials.
# Values are read by docker-compose and by the application (spring.config.import).
# Do not wrap values in quotes.

# PostgreSQL
POSTGRES_USER=wikipets
POSTGRES_PASSWORD=
POSTGRES_DB=wikipets
PGDATA=/var/lib/postgresql/data
# Optional, defaults to the docker-compose port mapping:
# DB_HOST=localhost
# DB_PORT=6000

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# Key used to sign the JWTs (at least 32 bytes). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Gmail account that sends the password recovery emails.
# MAIL_PASSWORD must be a Google app password, not the account password.
MAIL_USERNAME=
MAIL_PASSWORD=
